# Application Settings
APP_NAME="AI SaaS Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_saas
DB_USERNAME=root
DB_PASSWORD=

# AWS Microservices Endpoints
CONTENT_TRANSFORMATION_API=https://api.example.com/transform
MEETING_ASSISTANT_API=https://api.example.com/meeting
VOICE_GENERATION_API=https://api.example.com/voice
CUSTOMER_JOURNEY_API=https://api.example.com/journey
SYNTHETIC_DATA_API=https://api.example.com/data

# AWS Credentials (for microservices authentication)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# API Rate Limiting
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=1

# Cache Settings
CACHE_DRIVER=file
CACHE_PREFIX=ai_saas_

# Session Settings
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue Settings
QUEUE_CONNECTION=sync

# Mail Settings
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Microservices Timeout (seconds)
MICROSERVICES_TIMEOUT=30
